# YaarWin public_html security rules
# Protect bot state/user data and common private files from direct browser access.

Options -Indexes
DirectoryIndex index.html index.php default.php

<FilesMatch "^(users|user_state)\.json$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.env$|^\.ht|\.(bak|backup|old|orig|log|sql|sqlite|db|ini|yml|yaml|zip|tar|tgz|gz|7z|rar)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
</IfModule>
